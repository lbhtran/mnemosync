{
  "name": "mnemosync",
  "version": "0.1.0",
  "description": "Game tape for your coding agent — replay Claude Code sessions as an animated timeline, code alongside reasoning.",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "bin": {
    "mnemosync": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json && npm install --prefix web && npm run build --prefix web",
    "build:server": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts --no-open --port 4573",
    "test": "tsx --test tests/*.test.ts",
    "summary": "tsx src/cli.ts summary"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
